SaveManager="*res://scripts/autoload/save_manager.gd"
TTSManager="*res://scripts/autoload/tts_manager.gd"
StoryModeManager="*res://scripts/autoload/story_mode_manager.gd"
AutoPilot="*res://scripts/autoload/auto_pilot.gd"

