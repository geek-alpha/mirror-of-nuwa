CivilizationManager="*res://scripts/autoload/civilization_manager.gd"
HistoryManager="*res://scripts/autoload/history_manager.gd"
LLMService="*res://scripts/autoload/llm_service.gd"
ActionExecutor="*res://scripts/autoload/action_executor.gd"
PlayerGodController="*res://scripts/autoload/player_god_controller.gd"
